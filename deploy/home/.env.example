# Copy to /opt/health/.env and `chmod 600` it. These hold real secrets.

# The image tag to run. `make deploy-home IMAGE_TAG=...` rewrites this line.
IMAGE_TAG=

# The Cloudflare Tunnel's token: Zero Trust → Networks → Tunnels → your
# tunnel → the `--token` value in its install command.
TUNNEL_TOKEN=

# The passcode typed on the login page.
APP_PASSCODE=

# Optional. Signs the session cookie; without it the key is derived from the
# passcode, so changing the passcode logs every device out.
COOKIE_SECRET=

# AI insights and chat.
DEEPSEEK_API_KEY=

# Garmin sync.
GARMIN_EMAIL=
GARMIN_PASSWORD=
