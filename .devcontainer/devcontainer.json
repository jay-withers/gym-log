{
  "name": "gym-log",
  "image": "ghcr.io/jay-withers/dev-containers/terraform:v0.17.3@sha256:dbc5547b0a962e3e1bbd9a3f5f144daf92c017cc5533b675f5956874e9c54c18",
  "mounts": [
    // The same source works on every host: Docker Desktop (macOS, Windows)
    // resolves it inside its own VM. docker-socket-setup handles the ownership
    // difference (a docker group on Linux, a root-owned socket on Desktop).
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "hashicorp.terraform",
        "ms-python.python",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make install",
  "postStartCommand": "sudo /usr/local/bin/docker-socket-setup"
}
