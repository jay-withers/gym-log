# Copy to .env for local work. settings.py reads the environment first, then
# .env, then Key Vault — so with these set no Azure is involved at all.

# The passcode the login form checks. In Azure this lives in Key Vault as
# APP-PASSCODE and is never set as an environment variable.
APP_PASSCODE=local

# Leave empty to keep the log in a local file (LOCAL_STATE_PATH, default
# .gymlog.json) rather than in the blob.
STATE_CONTAINER_URL=

# Set to false to drop the login form entirely. Only ever sensible locally: the
# deployed app is reachable from the internet.
REQUIRE_PASSCODE=true
