{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>jay-withers/renovate"],
  "autoApprove": true,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)\\.terraform-version$"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)\\.tflint\\.hcl$"],
      "matchStrings": [
        "plugin \"azurerm\" \\{[^}]*version\\s*=\\s*\"(?<currentValue>[^\"]+)\"[^}]*source\\s*=\\s*\"github\\.com/(?<depName>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "A Python minor is not a routine bump: compiled deps (httptools via uvicorn[standard]) lag new interpreters with wheels, and the slim image has no compiler to build them. 3.15 broke the image this way in #72. Raise this ceiling by hand once the lock resolves to wheels for the new minor.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
