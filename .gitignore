# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# *.tfvars files are committed intentionally (dev/stg/prd environment inputs —
# see terraform/environments/*.tfvars). Do not put secrets in them; use Azure
# Key Vault, GitHub Actions secrets, or ARM_* environment variables instead.
# gitleaks (pre-commit and CI) scans every commit as a backstop.

# CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock file is committed: terraform/ is a deployable root configuration,
# so CI and every contributor should resolve the same provider versions.

# Saved plan output
*.tfplan

# macOS finder metadata
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
# pytest-cov's data file. Coverage runs in CI rather than in `make test`, so
# this only appears if someone measures locally by hand.
.coverage

# Node
node_modules/
dist/

# Local environment files. Every secret is read from an env var first (see
# src/gymlog/settings.py), so these hold real values.
.env
.env.*
# ...but a committed template holds none, and `.env.*` would otherwise swallow
# it silently.
!.env.example

# Vite build output and its cache
apps/dashboard/dist/

# The local training log, when running without a storage account.
.gymlog.json
